# Preview is the default. Do not enable indexing until launch review is complete.
DEPLOYMENT_ENV=preview
# Canonical origin is centralized in src/data/site.ts: https://elevatexlab.org
# Explicit future business decision: allow or block. Defaults to block.
GPTBOT_POLICY=block
# Public provider IDs are centralized in src/data/integrations.ts.
# All gates remain false until approved privacy text, consent and provider settings exist.
PUBLIC_TRACKING_ENABLED=false
PUBLIC_TRACKING_PRIVACY_APPROVED=false
PUBLIC_TRACKING_PROVIDER_REVIEWED=false
# Never put secrets in PUBLIC_ variables. Future server bindings are documented.
# INDEXNOW_KEY=
