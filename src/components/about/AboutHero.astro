---
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import ServiceActions from '../services/ServiceActions.astro';
import AboutArt from './AboutArt.astro';
---

<section
  class="about-hero"
  id="about-hero"
  aria-labelledby="about-title"
  data-about-hero
>
  <div class="about-hero__stage" data-about-scene="hero">
    <AboutArt name="hero" priority />
  </div>
  <div class="container about-hero__copy">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'About', path: '/about/' },
      ]}
    />
    <p class="about-eyebrow" data-about-hero-eyebrow>
      About ElevateX
    </p>
    <h1 id="about-title">
      <span class="about-mask">
        <span data-about-hero-line>Built with intention.</span>
      </span>
      <span class="about-mask">
        <span class="about-accent" data-about-hero-line>
          Driven by what’s possible.
        </span>
      </span>
    </h1>
    <p class="about-lead" data-about-hero-copy>
      ElevateX brings together thoughtful design, practical engineering, and
      AI-powered systems to help businesses create better digital experiences
      and more effective ways of working.
    </p>
    <div class="about-hero__actions" data-about-hero-actions>
      <ServiceActions
        primaryLabel="Explore Our Work"
        primaryHref="/work/"
        secondaryLabel="Our Approach"
        secondaryHref="#our-approach"
        source="about-hero"
      />
    </div>
  </div>
  <div class="container about-hero__annotation" aria-hidden="true">
    <span>Design / Engineering / AI</span>
    <span>Considered from the start.</span>
  </div>
</section>
