---
import HeroContent from './HeroContent.astro';
import HeroScene from './HeroScene.astro';
import '../../styles/hero.css';
---

<section
  class="hero"
  aria-labelledby="hero-title"
  data-hero-root
  data-motion="static"
>
  <HeroScene />
  <HeroContent />
</section>

<script>
  import { initializeHero } from '../../scripts/animations/hero-intro';

  let cleanup = initializeHero();
  document.addEventListener('astro:before-swap', () => cleanup());
  document.addEventListener('astro:page-load', () => {
    cleanup();
    cleanup = initializeHero();
  });
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) {
      cleanup();
      cleanup = initializeHero();
    }
  });
</script>
