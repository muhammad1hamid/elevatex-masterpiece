---
import HeroContent from './HeroContent.astro';
import HeroScene from './HeroScene.astro';
import '../../styles/hero.css';
---

<section
  class="hero"
  aria-labelledby="hero-title"
  data-hero-root
  data-motion="static"
>
  <HeroScene />
  <HeroContent />
  <div class="hero__intro" aria-hidden="true" hidden>
    <div class="hero__intro-wordmark">
      <span data-intro-elevate>Elevate</span>
      <span data-intro-x>
        X<i></i>
      </span>
    </div>
  </div>
  <button
    class="hero__motion-toggle"
    type="button"
    data-motion-toggle
    aria-pressed="false"
    hidden
  >
    <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
      <path d="M3 2v8M9 2v8" stroke="currentColor" stroke-width="1.5" />
    </svg>
    <span>Pause motion</span>
  </button>
</section>

<script>
  import { initializeHero } from '../../scripts/animations/hero-intro';

  let cleanup = initializeHero();
  document.addEventListener('astro:before-swap', () => cleanup());
  document.addEventListener('astro:page-load', () => {
    cleanup();
    cleanup = initializeHero();
  });
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) {
      cleanup();
      cleanup = initializeHero();
    }
  });
</script>
