---
import ServiceActions from '../services/ServiceActions.astro';
import EditorialHeading from './EditorialHeading.astro';
---

<section
  class="journal-cta journal-section container"
  aria-labelledby="journal-cta-title"
>
  <EditorialHeading
    id="journal-cta-title"
    eyebrow="Have something in mind?"
    first="Read something useful?"
    second="Let’s build something meaningful."
    intro="Tell us which idea you want to apply, how the task works today, and what should happen differently."
  />
  <ServiceActions
    primaryLabel="Start a Project"
    primaryHref="/contact/"
    secondaryLabel="Explore Our Work"
    secondaryHref="/work/"
    source="insights-final"
  />
</section>
