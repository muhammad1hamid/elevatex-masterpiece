---
import FAQItem from '../faq/FAQItem.astro';
import { faqs } from '../../data/faqs';
import '../../styles/faq-section.css';
---

<section class="faq-section" id="faq" aria-labelledby="faq-heading">
  <header class="faq-section__intro">
    <p class="faq-section__eyebrow">
      Common Questions <span>/ 09</span>
    </p>
    <h2 id="faq-heading">
      <span>Clear answers.</span> <span>Less uncertainty.</span>
    </h2>
    <p class="faq-section__lead">
      Everything you may want to know before working with ElevateX — from
      project scope and timelines to AI integrations and what happens after
      launch.
    </p>
  </header>

  <picture class="faq-section__photo" aria-hidden="true">
    <source
      type="image/avif"
      srcset="/images/faq/elevatex-workspace-768.avif 768w, /images/faq/elevatex-workspace-1280.avif 1280w, /images/faq/elevatex-workspace-1672.avif 1672w"
      sizes="(max-width: 68.75rem) 100vw, 100rem"
    />
    <source
      type="image/webp"
      srcset="/images/faq/elevatex-workspace-768.webp 768w, /images/faq/elevatex-workspace-1280.webp 1280w, /images/faq/elevatex-workspace-1672.webp 1672w"
      sizes="(max-width: 68.75rem) 100vw, 100rem"
    />
    <img
      src="/images/faq/elevatex-workspace-1280.webp"
      alt=""
      width="1672"
      height="941"
      loading="lazy"
      decoding="async"
    />
  </picture>

  <ul class="faq-section__capabilities" aria-label="ElevateX services">
    <li>
      <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
        <rect x="3" y="4" width="18" height="13" rx="1.5"></rect>
        <path d="M8 21h8M12 17v4M7 8h10M7 11h6"></path>
      </svg>
      <span>
        Web
        <br />
        Development
      </span>
    </li>
    <li>
      <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
        <path d="M12 3v2m0 14v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M3 12h2m14 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        <circle cx="12" cy="12" r="5"></circle>
        <path d="m10.5 12 1 1 2-2"></path>
      </svg>
      <span>
        AI
        <br />
        Automation
      </span>
    </li>
    <li>
      <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
        <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v9a2.5 2.5 0 0 1-2.5 2.5H11l-5 4v-4.2A2.5 2.5 0 0 1 4 14.5z"></path>
        <path d="M8 9h8M8 12h5"></path>
      </svg>
      <span>
        AI
        <br />
        Chatbots
      </span>
    </li>
    <li>
      <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
        <path d="m12 3 9 5-9 5-9-5zM3 12l9 5 9-5M3 16l9 5 9-5"></path>
      </svg>
      <span>
        Landing
        <br />
        Pages
      </span>
    </li>
  </ul>
  <div class="faq-section__content">
    <ol class="faq-section__list" aria-label="Frequently asked questions">
      {faqs.map((faq) => (
        <FAQItem faq={faq} />
      ))}
    </ol>
  </div>

  <aside class="faq-section__contact">
    <p class="faq-section__contact-eyebrow">Still have a question?</p>
    <h3>We’re here to help.</h3>
    <p>
      If you couldn’t find the answer you’re looking for, send us a message and
      we’ll help you figure out the right next step.
    </p>
    <a href="/contact/">
      Contact Us <span aria-hidden="true">→</span>
    </a>
  </aside>
</section>
