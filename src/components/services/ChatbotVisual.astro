<div class="chat-visual">
  <div class="chat-visual__header">
    <span class="chat-visual__avatar">X</span>
    <div>
      <span>Customer assistant</span>
      <small>Conversation concept</small>
    </div>
    <span class="chat-visual__indicator"></span>
  </div>
  <div class="chat-visual__messages">
    <div class="chat-visual__message chat-visual__message--customer">
      <small>Customer</small>
      <p>Can I book an appointment?</p>
    </div>
    <div class="chat-visual__message chat-visual__message--assistant">
      <small>Assistant</small>
      <p>Absolutely. What day works best for you?</p>
    </div>
    <div class="chat-visual__choices">
      <span>Tomorrow</span>
      <span>
        Choose a day <span>↗</span>
      </span>
    </div>
  </div>
  <div class="chat-visual__composer">
    <span>A clearer path to the next step</span>
    <span>↗</span>
  </div>
</div>
