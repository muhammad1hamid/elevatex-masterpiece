---
import AutomationIntro from './AutomationIntro.astro';
import { inquirySteps } from '../../../data/services/ai-automation';
---

<section
  class="automation-section automation-workflow"
  id="automation-workflow"
  aria-labelledby="automation-workflow-heading"
  data-automation-workflow
>
  <div class="container">
    <AutomationIntro
      id="automation-workflow-heading"
      eyebrow="From trigger to outcome / 05"
      heading="See what happens between request and result."
      lead="Follow one website-redesign inquiry from input to confirmed continuation. AI suggests the meaning; rules validate it; a person approves the next action."
    />
    <fieldset class="inquiry-system">
      <legend>Select a step in the example workflow.</legend>
      <div class="inquiry-system__meta">
        <span>Website redesign inquiry · {inquirySteps.length} stages</span>
        <span>Illustrative sequence · No live actions</span>
      </div>
      <ol class="inquiry-system__steps">
        {inquirySteps.map((step, index) => (
          <li
            class="inquiry-step"
            data-inquiry-step
            style={`--step-index:${index}`}
          >
            <input
              class="inquiry-step__radio"
              type="radio"
              name="inquiry-step"
              id={`inquiry-${step.id}`}
              value={step.id}
              aria-describedby={`inquiry-${step.id}-description`}
              checked={index === 0}
            />
            <h3>
              <label for={`inquiry-${step.id}`}>
                <span class="inquiry-step__number">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span>{step.title}</span>
                <span class="inquiry-step__marker" aria-hidden="true" />
              </label>
            </h3>
            <p id={`inquiry-${step.id}-description`}>{step.description}</p>
            <span class="automation-tag">{step.kind}</span>
            <div class="inquiry-detail" data-inquiry-detail={step.id}>
              <div class="inquiry-detail__index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
                <span>/ {String(inquirySteps.length).padStart(2, '0')}</span>
              </div>
              <div>
                <p class="automation-tag">{step.key}</p>
                <p class="inquiry-detail__value">{step.value}</p>
                <ul>
                  {step.details.map((detail) => (
                    <li>{detail}</li>
                  ))}
                </ul>
                <p class="inquiry-detail__boundary">
                  <strong>The boundary.</strong> {step.boundary}
                </p>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </fieldset>
    <div
      class="inquiry-exceptions"
      id="automation-control"
      aria-labelledby="automation-control-heading"
    >
      <h3 id="automation-control-heading">When the normal path stops</h3>
      <dl>
        <div>
          <dt>Missing data → Review</dt>
          <dd>
            The example lacks a current site and goals. Ask for them; keep the
            record incomplete. An authorized reviewer decides whether a draft
            may proceed.
          </dd>
        </div>
        <div id="automation-reliability">
          <dt>Rejected update → Exception</dt>
          <dd>
            Do not announce success or start follow-ups. Notify the owner,
            preserve context and check status before a safe retry. Duplicate
            prevention, rate limits and logging are scoped to the workflow.
          </dd>
        </div>
      </dl>
      <p>
        Manual override, least-required access, retention and external-service
        responsibilities are agreed before implementation.
      </p>
    </div>
    <p class="automation-footnote">
      This example illustrates the logic. The actual sequence, permissions, and
      approval points are defined around your workflow.
    </p>
  </div>
</section>
