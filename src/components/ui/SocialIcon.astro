}
const { name } = Astro.props;
---

<svg
  width="22"
  height="22"
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {name === 'instagram' && (
    <>
      <rect
        x="3"
        y="3"
        width="18"
        height="18"
        rx="5"
        stroke="currentColor"
        stroke-width="1.7"
      />
      <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7" />
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
    </>
  )}
  {name === 'linkedin' && (
    <path
      fill="currentColor"
      d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8V14.1c0-1.11-.02-2.53-1.54-2.53-1.54 0-1.78 1.2-1.78 2.45v4.73H9.53V9.2h2.83v1.3h.04c.4-.75 1.36-1.54 2.79-1.54 2.98 0 3.56 1.96 3.56 4.5v5.29Z"
    />
  )}
  {name === 'whatsapp' && (
    <>
      <path
        d="M20.5 11.7a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.3-4.8A8.5 8.5 0 1 1 20.5 11.7Z"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"
      />
      <path
        d="m8.4 7.2 1.1 2.6-.9 1.1c.8 1.6 1.9 2.7 3.5 3.5l1.1-.9 2.6 1.1c.2.1.3.4.2.6-.4 1.2-1.3 1.7-2.5 1.4-3.5-.8-6.2-3.5-7-7-.3-1.2.2-2.1 1.4-2.5.2-.1.5 0 .5.1Z"
        fill="currentColor"
      />
