---
import type {
  Differentiator,
  DifferenceIcon,
} from '../../data/differentiators';

interface Props {
  difference: Differentiator;
}
const { difference } = Astro.props;
// Small, local line icons. No icon runtime or external sprite request.
const iconPaths: Record<DifferenceIcon, string[]> = {
  target: [
    'M19.1 8.3a8 8 0 1 1-3.4-3.4',
    'M15.9 11.1a4 4 0 1 1-3-3',
    'm12 12 8-8M17 4h3v3',
  ],
  network: [
    'M10 5a2 2 0 1 0 4 0 2 2 0 0 0-4 0ZM3 18a2 2 0 1 0 4 0 2 2 0 0 0-4 0ZM17 18a2 2 0 1 0 4 0 2 2 0 0 0-4 0ZM10 13a2 2 0 1 0 4 0 2 2 0 0 0-4 0Z',
    'M12 7v4m-2 3-3.5 2.5M14 14l3.5 2.5',
  ],
  layers: ['m12 3 9 5-9 5-9-5 9-5Z', 'm3 12 9 5 9-5M3 16l9 5 9-5'],
  messages: [
    'M4 4h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H8l-5 3V6a2 2 0 0 1 1-2Z',
    'M17 8h2a2 2 0 0 1 2 2v11l-5-3h-4a2 2 0 0 1-2-2',
  ],
  workflow: [
    'M3 3h6v6H3V3ZM15 15h6v6h-6v-6Z',
    'M9 6h6a3 3 0 0 1 3 3v3m-3-3 3 3 3-3M6 9v6a3 3 0 0 0 3 3h3',
    'm10 16 2 2-2 2',
  ],
  blocks: [
    'M3 12h8v9H3v-9ZM13 12h8v9h-8v-9ZM3 3h8v7H3V3Z',
    'M14 6h7m-3.5-3.5v7',
  ],
};
---

<article
  class="why-elevatex__card"
  aria-labelledby={`difference-${difference.id}`}
  data-difference-reveal
>
  <div class="why-elevatex__card-surface">
    <div class="why-elevatex__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" focusable="false">
        {iconPaths[difference.icon].map((path) => (
          <path d={path} />
        ))}
      </svg>
    </div>
    <h3 id={`difference-${difference.id}`} class="why-elevatex__card-title">
      {difference.title}
    </h3>
    <p class="why-elevatex__card-description">{difference.description}</p>
  </div>
</article>
