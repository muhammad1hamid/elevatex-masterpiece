---
import type { GetStaticPaths } from 'astro';
import '../styles/fonts.css';

// Preserve existing Services bookmarks in every build. Navigation links directly
// to the real homepage section; this noindex handoff is not a service overview.
export const getStaticPaths = (() => {
  return [
    { params: { destination: 'services' }, props: { target: '/#services' } },
  ];
}) satisfies GetStaticPaths;

interface Props {
  target: string;
}

const { target } = Astro.props;
const label = 'Continue to ElevateX services';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>Continue to ElevateX</title>
  </head>
  <body>
    <main>
      <h1>Continue to ElevateX</h1>
      <p>
        <a href={target}>{label}</a>
      </p>
    </main>
  </body>
</html>

<style>
  html {
    color-scheme: dark;
    font-family: system-ui, sans-serif;
    background: #0c0c0b;
    color: #f3f0e9;
  }

  body {
    margin: 0;
  }

  main {
    max-width: 40rem;
    margin-inline: auto;
    padding: 4rem 1.5rem;
  }

  h1 {
    font-family: 'Outfit', Arial, sans-serif;
    font-weight: 400;
    letter-spacing: -0.035em;
    font-size: 1.75rem;
  }

  a {
    color: #e8d7b3;
    text-underline-offset: 0.25em;
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 5px;
  }
</style>
