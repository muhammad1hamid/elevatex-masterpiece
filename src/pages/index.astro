---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import ProofSection from '../components/sections/ProofSection.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import FeaturedSystemSection from '../components/sections/FeaturedSystemSection.astro';
import WhyElevateXSection from '../components/sections/WhyElevateXSection.astro';
import ProcessSection from '../components/sections/ProcessSection.astro';
import FounderSection from '../components/sections/FounderSection.astro';
import InsightsSection from '../components/sections/InsightsSection.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import FinalCTASection from '../components/sections/FinalCTASection.astro';
import { homepageMetadata, staticPages } from '../data/site';
import {
  organizationSchema,
  websiteSchema,
  webPageSchema,
} from '../utils/structured-data';
---

<BaseLayout
  hero={true}
  title={homepageMetadata.title}
  description={homepageMetadata.description}
  image={homepageMetadata.image}
  path="/"
  indexable={staticPages.find((page) => page.path === '/')?.indexable ?? false}
  schema={[
    organizationSchema(),
    websiteSchema(),
    webPageSchema({
      title: homepageMetadata.title,
      description: homepageMetadata.description,
      path: '/',
    }),
  ]}
>
  <Fragment slot="head">
    <link
      rel="preload"
      href="/fonts/bodoni-moda-latin-opsz-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-sans-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </Fragment>
  <Hero />
  <ProofSection />
  <ServicesSection />
  <FeaturedSystemSection />
  <WhyElevateXSection />
  <ProcessSection />
  <FounderSection />
  <InsightsSection />
  <FAQSection />
  <FinalCTASection />
</BaseLayout>
