---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import { site, services, staticPages } from '../data/site';
import {
  organizationSchema,
  websiteSchema,
  webPageSchema,
} from '../utils/structured-data';
---

<BaseLayout
  hero={true}
  title="Premium Digital Systems For Serious Growth"
  description={site.description}
  path="/"
  indexable={staticPages.find((page) => page.path === '/')?.indexable ?? false}
  schema={[
    organizationSchema(),
    websiteSchema(),
    webPageSchema({
      title: site.headline,
      description: site.description,
      path: '/',
    }),
  ]}
>
  <Fragment slot="head">
    <link
      rel="preload"
      href="/fonts/bodoni-moda-latin-opsz-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/bodoni-moda-latin-opsz-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-sans-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </Fragment>
  <Hero />
  <section
    class="container services-overview"
    id="services"
    aria-labelledby="services-heading"
  >
    <p class="eyebrow">Our focus</p>
    <h2 id="services-heading">Core services</h2>
    <ul class="service-list">
      {services.map((service, index) => (
        <li>
          <span class="service-number" aria-hidden="true">
            0{index + 1}
          </span>
          <span>{service.name}</span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
