---
import { render } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { publishedInsights } from '../../utils/content';
import { contentPath } from '../../utils/publication';
import {
  articleSchema,
  breadcrumbSchema,
  organizationSchema,
} from '../../utils/structured-data';
export async function getStaticPaths() {
  return (await publishedInsights()).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry } = Astro.props;
const { Content } = await render(entry);
const path = contentPath('insights', entry.id);
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: entry.data.title, path },
];
const image = entry.data.featuredImage;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  path={path}
  indexable={true}
  type="article"
  image={image}
  schema={[
    organizationSchema(),
    breadcrumbSchema(breadcrumbs),
    articleSchema({
      title: entry.data.title,
      description: entry.data.description,
      path,
      author: entry.data.author,
      publishedDate: entry.data.publishedDate,
      updatedDate: entry.data.updatedDate,
      image: image?.src,
    }),
  ]}
>
  <article class="container">
    <header class="article-header prose">
      <Breadcrumbs items={breadcrumbs} />
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
      <p>
        By{' '}
        {entry.data.author.url ? (
          <a href={entry.data.author.url} rel="author">
            {entry.data.author.name}
          </a>
        ) : (
          entry.data.author.name
        )}{' '}
        ·{' '}
        <time datetime={entry.data.publishedDate.toISOString()}>
          {entry.data.publishedDate.toLocaleDateString('en', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            timeZone: 'UTC',
          })}
        </time>
      </p>
      {entry.data.updatedDate && (
        <p>
          Updated{' '}
          <time datetime={entry.data.updatedDate.toISOString()}>
            {entry.data.updatedDate.toISOString().slice(0, 10)}
          </time>
        </p>
      )}
      {image && (
        <img
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          decoding="async"
        />
      )}
    </header>
    <div class="prose article-body">
      <Content />
      {entry.data.sources.length > 0 && (
        <section aria-labelledby="sources-heading">
          <h2 id="sources-heading">Sources</h2>
          <ul>
            {entry.data.sources.map((source) => (
              <li>
                <a href={source.url}>{source.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </article>
</BaseLayout>
