---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AutomationHero from '../../components/services/automation/AutomationHero.astro';
import AutomationIntro from '../../components/services/automation/AutomationIntro.astro';
import InquiryWorkflow from '../../components/services/automation/InquiryWorkflow.astro';
import ServiceFAQ from '../../components/services/ServiceFAQ.astro';
import ServiceCTA from '../../components/services/ServiceCTA.astro';
import {
  aiAutomation,
  automationProblems,
  automationCapabilities,
  automationUseCases,
  integrationGroups,
  automationBuildStages,
  automationDeliverables,
  automationFAQs,
} from '../../data/services/ai-automation';
import { staticPages } from '../../data/site';
import {
  organizationSchema,
  websiteSchema,
  webPageSchema,
  serviceSchema,
  breadcrumbSchema,
} from '../../utils/structured-data';
import '../../styles/ai-automation.css';
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'AI Automation', path: aiAutomation.path },
];
---

<BaseLayout
  title={aiAutomation.title}
  description={aiAutomation.description}
  path={aiAutomation.path}
  image={aiAutomation.image}
  indexable={
    staticPages.find((page) => page.path === aiAutomation.path)?.indexable ??
    false
  }
  schema={[
    organizationSchema(),
    websiteSchema(),
    webPageSchema({
      title: aiAutomation.title,
      description: aiAutomation.description,
      path: aiAutomation.path,
    }),
    serviceSchema({
      name: 'AI Automation',
      description: aiAutomation.description,
      path: aiAutomation.path,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <Fragment slot="head">
    <link
      rel="preload"
      href="/fonts/instrument-sans-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </Fragment>
  <article class="automation-page" data-ai-automation>
    <AutomationHero />
    <section
      class="automation-principles"
      id="automation-principles"
      aria-label="Automation project principles"
    >
      <ul class="container">
        {[
          'Reduce repetition',
          'Connect systems',
          'Keep human control',
          'Design for reliability',
        ].map((label) => (
          <li>
            <span aria-hidden="true">+</span>
            {label}
          </li>
        ))}
      </ul>
    </section>
    <section
      class="automation-section"
      id="automation-problems"
      aria-labelledby="automation-problems-heading"
    >
      <div class="container">
        <AutomationIntro
          id="automation-problems-heading"
          eyebrow="Where time disappears / 03"
          heading="Busy work quietly slows everything down."
          lead="Repetitive admin, manual handoffs, copy-and-paste work, missed follow-ups, and disconnected tools can consume time without creating meaningful value."
        />
        <div class="automation-bottleneck">
          <ul>
            {automationProblems.slice(0, 4).map((item) => (
              <li>
                {item}
                <span aria-hidden="true">↘</span>
              </li>
            ))}
          </ul>
          <div class="automation-bottleneck__center">
            <span class="automation-tag">The manual bottleneck</span>
            <p>
              Every step waits
              <br />
              for someone.
            </p>
            <div aria-hidden="true">
              <i></i>
              <i></i>
              <i></i>
            </div>
          </div>
          <ul>
            {automationProblems.slice(4).map((item) => (
              <li>
                <span aria-hidden="true">↙</span>
                {item}
              </li>
            ))}
          </ul>
          <p class="automation-bottleneck__bottom">
            Repeated effort<span aria-hidden="true">/</span>Delayed handoffs
            <span aria-hidden="true">/</span>Inconsistent next steps
          </p>
        </div>
      </div>
    </section>
    <section
      class="automation-section automation-capabilities"
      id="automation-capabilities"
      aria-labelledby="automation-capabilities-heading"
    >
      <div class="container">
        <AutomationIntro
          id="automation-capabilities-heading"
          eyebrow="What we automate / 04"
          heading="Turn repeated steps into connected workflows."
          lead="AI automation combines software connections and defined rules with AI-assisted interpretation of information. ElevateX maps the process, identifies where AI is useful, and keeps validation and human decisions where they belong."
        />
        <div class="automation-capability-map">
          <div class="automation-capability-map__core">
            <span aria-hidden="true">↳</span>
            <p>Automation logic</p>
            <span class="automation-tag">Inputs → Rules → Actions</span>
          </div>
          <dl>
            {automationCapabilities.map((item, index) => (
              <div>
                <dt>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  {item.title}
                </dt>
                <dd>{item.detail}</dd>
              </div>
            ))}
          </dl>
        </div>
        <p class="automation-footnote">
          The right opportunities depend on the process, supported connections,
          and what your team needs to control.
        </p>
      </div>
    </section>
    <InquiryWorkflow />
    <section
      class="automation-section automation-use-cases"
      id="automation-use-cases"
      aria-labelledby="automation-use-cases-heading"
    >
      <div class="container">
        <AutomationIntro
          id="automation-use-cases-heading"
          eyebrow="Real use cases / 06"
          heading="Different workflows. Same principle."
          lead="Start with the repeated process, then design the automation around what the business actually needs. These examples illustrate possible workflows, rather than verified client outcomes."
        />
        <div class="automation-stories">
          {automationUseCases.map((item, index) => (
            <article class="automation-story" data-automation-use-case>
              <header>
                <span class="automation-story__number" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <p class="automation-tag">{item.label}</p>
                <h3>{item.title}</h3>
              </header>
              <dl>
                {[
                  ['Trigger', item.trigger],
                  ['Automation', item.automation],
                  ['Output', item.output],
                  ['Human', item.human],
                ].map(([label, text]) => (
                  <div>
                    <dt>{label}</dt>
                    <dd>{text}</dd>
                  </div>
                ))}
              </dl>
              {item.demo && (
                <p class="automation-story__note">
                  The existing restaurant Product Demo shows a structured order
                  draft awaiting confirmation.{' '}
                  <a href="/#featured-system">
                    Explore the Product Demo <span aria-hidden="true">↗</span>
                  </a>
                </p>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section
      class="automation-section"
      id="automation-integrations"
      aria-labelledby="automation-integrations-heading"
    >
      <div class="container">
        <AutomationIntro
          id="automation-integrations-heading"
          eyebrow="Connected systems / 08"
          heading="Automation becomes useful when your tools can work together."
          lead="Depending on the project, workflows can connect websites, messaging channels, forms, spreadsheets, databases, CRM tools, APIs, webhooks, and other business systems."
        />
        <div class="automation-integration-map">
          <div class="automation-integration-map__core">
            <span class="automation-tag">A connected business workflow</span>
            <p>
              The tools you use.
              <br />A shared sequence.
            </p>
            <span aria-hidden="true">↔</span>
          </div>
          <dl>
            {integrationGroups.map((group) => (
              <div>
                <dt>{group.title}</dt>
                <dd>
                  <strong>{group.items}</strong>
                  <p>{group.detail}</p>
                </dd>
              </div>
            ))}
          </dl>
        </div>
        <p class="automation-integration-note">
          <strong>WhatsApp-based workflows</strong> can be developed where the
          required platform access and integration setup are available.
          Capabilities depend on the account, platform rules, and supported
          connection method.
        </p>
        <p class="automation-footnote">
          Connections are assessed for each project. Tool names describe
          possible endpoints, not official partnerships or preconfigured
          integrations.
        </p>
      </div>
    </section>
    <section
      class="automation-section automation-build"
      id="automation-build"
      aria-labelledby="automation-build-heading"
    >
      <div class="container">
        <AutomationIntro
          id="automation-build-heading"
          eyebrow="How we build automations / 09"
          heading="Understand the process. Then build the system."
          lead="We agree the workflow, responsibilities, and expected behavior before connecting the pieces."
        />
        <ol class="automation-build__stages">
          {automationBuildStages.map((stage, index) => (
            <li>
              <span class="automation-build__number">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{stage.title}</h3>
              <p>{stage.description}</p>
              <span class="automation-build__outcome">{stage.outcome}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section
      class="automation-section automation-deliverables"
      id="automation-deliverables"
      aria-labelledby="automation-deliverables-heading"
    >
      <div class="container">
        <AutomationIntro
          id="automation-deliverables-heading"
          eyebrow="What a project can include / 11"
          heading="The automation is more than the final workflow."
          lead="The exact scope depends on the workflow, tools involved, and level of automation required. Deliverables are defined before implementation begins."
        />
        <ol class="automation-deliverables__layers">
          {automationDeliverables.map((stage, index) => (
            <li>
              <span class="automation-tag">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{stage.title}</h3>
              <p>{stage.detail}</p>
            </li>
          ))}
        </ol>
        <p class="automation-related">
          Building the experience around the workflow?{' '}
          <a href="/services/web-development/">
            Explore Web Development <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </section>
    <ServiceFAQ
      items={automationFAQs}
      id="automation-faq"
      name="automation-faq"
      eyebrow="Common questions / 12"
      heading="Questions before automating a workflow."
      lead="Practical answers about tools, approvals, scope, and ongoing operation."
      ctaLabel="Discuss an Automation"
      centered
    />
    <ServiceCTA
      id="automation-cta"
      eyebrow="Ready to improve the workflow? / 13"
      heading="There’s probably a better way to run that process."
      emphasis="Let’s find it."
      supporting="Describe one repeated task, the tools it passes through, and where someone must review or approve the next step."
      primaryLabel="Discuss an Automation"
      secondaryLabel="Explore Our Work"
      source="ai_automation_final_cta"
    />
  </article>
</BaseLayout>
<script>
  import { initializeAutomationPage } from '../../scripts/animations/ai-automation';
  initializeAutomationPage();
</script>
