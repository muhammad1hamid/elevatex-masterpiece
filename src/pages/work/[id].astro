---
import type { InferGetStaticPropsType } from 'astro';
import {
  publishedCaseStudies,
  publishedProjectStudies,
} from '../../utils/content';
import DocumentedCaseStudy from '../../components/case-studies/DocumentedCaseStudy.astro';
import CaseStudyLayout from '../../components/case-studies/CaseStudyLayout.astro';
export async function getStaticPaths() {
  const paths = [
    ...(await publishedCaseStudies()).map((entry) => ({
      params: { id: entry.id },
      props: { kind: 'documented' as const, entry },
    })),
    ...(await publishedProjectStudies()).map((entry) => ({
      params: { id: entry.data.projectStudy?.slug ?? entry.id },
      props: { kind: 'cinematic' as const, entry },
    })),
  ];
  const seen = new Set<string>();
  for (const route of paths) {
    if (seen.has(route.params.id))
      throw new Error(`Duplicate case-study route: ${route.params.id}`);
    seen.add(route.params.id);
  }
  return paths;
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const props = Astro.props;
---

{props.kind === 'cinematic' ? (
  <CaseStudyLayout project={props.entry.data} id={props.entry.id} />
) : (
  <DocumentedCaseStudy entry={props.entry} />
)}
